# Copy to .env.local — never commit secrets
#
# Local defaults match hosted Dev (riverdb-dev / *ApiDev). See docs/environments.md.

NEXT_PUBLIC_DEV=true

# Firebase client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aquaflow-management-suite.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aquaflow-management-suite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=smartrefill-singapore
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Match hosted Dev Firestore
NEXT_PUBLIC_FIRESTORE_DB=riverdb-dev

# reCAPTCHA v3 (App Check provider — public site key)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# App Check debug token (local dev only — register in Firebase Console → App Check → Manage debug tokens)
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Sales Portal API
# Hosted Dev fallback (used when NEXT_PUBLIC_DEV is not true, or as non-local target):
NEXT_PUBLIC_SALES_PORTAL_API_URL=https://asia-southeast1-aquaflow-management-suite.cloudfunctions.net/salesPortalApiDev
# Local API (`npm run serve:local` / port 8071) — keep for NEXT_PUBLIC_DEV=true
NEXT_PUBLIC_SALES_PORTAL_API_URL_DEV=http://127.0.0.1:8071

# SmartRefill V3 API (proxied via /smartrefill on Sales Portal API) — Dev tier
NEXT_PUBLIC_SMARTREFILL_API_URL=https://asia-southeast1-aquaflow-management-suite.cloudfunctions.net/smartrefillV3ApiDev
NEXT_PUBLIC_SMARTREFILL_API_URL_DEV=https://asia-southeast1-aquaflow-management-suite.cloudfunctions.net/smartrefillV3ApiDev

# Smart Refill public app origin (Resources share links) — Dev App Hosting
NEXT_PUBLIC_SMARTREFILL_APP_URL=https://dev-smartrefill--aquaflow-management-suite.asia-southeast1.hosted.app
